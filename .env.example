LLM_PROVIDER=cursor
CURSOR_API_KEY=
OPENROUTER_API_KEY=
LLM_MODEL=composer-2.5
INPUT_FILE=dav.docx
OUTPUT_DIR=output
LOGS_DIR=logs
MAX_RETRIES=2
REQUEST_DELAY_SEC=1

# Leeloo.ai CRM (можно скопировать из D:\CursorProjects\lilu_chats\.env)
LILU_API_URL=https://api.leeloo.ai/api
LILU_API_KEY=X-Leeloo-AuthToken
LILU_API_SECRET=
LILU_API_VERSION=v2
LILU_TIMEOUT=30
LILU_MAX_RETRIES=3
LILU_RETRY_DELAY=1
# LILU_VERIFY_SSL=false

# CRM response-time SLA (Asia/Tbilisi, Mon–Fri)
CRM_TIMEZONE=Asia/Tbilisi
CRM_WORK_START=10:00
CRM_WORK_END=18:00
CRM_WORK_DAYS=0,1,2,3,4
CRM_SLA_WORK_SEC=120
CRM_SLA_OFF_SEC=900
